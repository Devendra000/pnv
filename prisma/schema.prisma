generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OwnerType {
  SINGLE
  MULTIPLE
}

model Company {
  id               String              @id @default(cuid())
  name             String
  ownerType        OwnerType           @default(SINGLE) @map("owner_type")
  registrationDate DateTime?           @map("registration_date")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  rootFolderId     String?             @unique @map("root_folder_id")
  rootFolder       CompanyFolder?      @relation("CompanyRootFolder", fields: [rootFolderId], references: [id], onDelete: SetNull)
  folders          CompanyFolder[]     @relation("CompanyFolders")
  owners           CompanyOwner[]
  witnesses        CompanyWitness[]
  objectives       CompanyObjective[]
  variableValues   CompanyVariableValue[]
  documents        GeneratedDocument[]

  @@map("companies")
}

model CompanyOwner {
  id              String   @id @default(cuid())
  companyId       String   @map("company_id")
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  address         String?
  sharePercentage Float?   @map("share_percentage")
  order           Int      @default(0)

  @@map("company_owners")
}

model CompanyWitness {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  order     Int      @default(0)

  @@map("company_witnesses")
}

model Objective {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("objectives")
}

model CompanyObjective {
  id                String   @id @default(cuid())
  companyId         String   @map("company_id")
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceObjectiveId String?  @map("source_objective_id")
  text              String
  order             Int      @default(0)

  @@map("company_objectives")
}

model Variable {
  id    String @id @default(cuid())
  key   String @unique
  label String
  type  String @default("text") // text | date | number | list

  companyValues CompanyVariableValue[]

  @@map("variables")
}

model CompanyVariableValue {
  id         String  @id @default(cuid())
  companyId   String  @map("company_id")
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  variableId  String  @map("variable_id")
  variable    Variable @relation(fields: [variableId], references: [id], onDelete: Cascade)
  value      String

  @@unique([companyId, variableId])
  @@map("company_variable_values")
}

model CompanyFolder {
  id         String   @id @default(cuid())
  companyId  String   @map("company_id")
  company    Company  @relation("CompanyFolders", fields: [companyId], references: [id], onDelete: Cascade)
  parentFolderId String? @map("parent_folder_id")
  parentFolder CompanyFolder? @relation("CompanyFolderTree", fields: [parentFolderId], references: [id], onDelete: Cascade)
  children   CompanyFolder[] @relation("CompanyFolderTree")
  rootOfCompany Company? @relation("CompanyRootFolder")
  name       String   @default("Documents")
  path       String   @unique
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  documents  GeneratedDocument[]

  @@index([companyId])
  @@map("company_folders")
}

model Template {
  id        String   @id @default(cuid())
  name      String
  fileUrl   String   @map("file_url")
  createdAt DateTime @default(now()) @map("created_at")

  documents GeneratedDocument[]

  @@map("templates")
}

model GeneratedDocument {
  id          String   @id @default(cuid())
  folderId    String?  @map("folder_id")
  folder      CompanyFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  templateId  String   @map("template_id")
  template    Template @relation(fields: [templateId], references: [id])
  companyId   String   @map("company_id")
  company     Company  @relation(fields: [companyId], references: [id])
  docxUrl     String   @map("docx_url")
  pdfUrl      String?  @map("pdf_url")
  generatedAt DateTime @default(now()) @map("generated_at")

  @@map("generated_documents")
}
