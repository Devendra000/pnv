generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OwnerType {
  SINGLE
  MULTIPLE
}

model Company {
  id               String              @id @default(cuid())
  englishName      String              @map("english_name")
  nepaliName       String              @map("nepali_name")
  ownerType        OwnerType           @default(SINGLE) @map("owner_type")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  owners           CompanyOwner[]
  witnesses        CompanyWitness[]
  objectives       CompanyObjective[]
  variableValues   CompanyVariableValue[]
  documents        GeneratedDocument[]
  folders          CompanyFolder[]

  @@map("companies")
}

model CompanyOwner {
  id                  String   @id @default(cuid())
  companyId           String   @map("company_id")
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                String
  fatherName          String?  @map("father_name")
  address             String?
  citizenship         String?
  jariJilla           String?  @map("jari_jilla")
  citizenshipJariDate String?  @map("citizenship_jari_date")
  phoneNumber         String?  @map("phone_number")
  shares              String?
  order               Int      @default(0)

  @@map("company_owners")
}

model CompanyWitness {
  id                  String   @id @default(cuid())
  companyId           String   @map("company_id")
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                String
  address             String?
  citizenship         String?
  jariJilla           String?  @map("jari_jilla")
  citizenshipJariDate String?  @map("citizenship_jari_date")
  phoneNumber         String?  @map("phone_number")
  ownerIndex          Int?     @map("owner_index") // 1-based index of the owner this witness belongs to; null = general
  order               Int      @default(0)

  @@map("company_witnesses")
}

model ObjectiveCategory {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  order       Int         @default(0)
  createdAt   DateTime    @default(now()) @map("created_at")
  objectives  Objective[]

  @@map("objective_categories")
}

model Objective {
  id         String             @id @default(cuid())
  categoryId String?            @map("category_id")
  category   ObjectiveCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  text       String
  createdAt  DateTime           @default(now()) @map("created_at")

  @@map("objectives")
}

model CompanyObjective {
  id                String   @id @default(cuid())
  companyId         String   @map("company_id")
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceObjectiveId String?  @map("source_objective_id")
  text              String
  order             Int      @default(0)

  @@map("company_objectives")
}

model Variable {
  id    String @id @default(cuid())
  key   String @unique
  label String
  type  String @default("text") // text | date | number | list

  companyValues CompanyVariableValue[]

  @@map("variables")
}

model CompanyVariableValue {
  id         String   @id @default(cuid())
  companyId  String   @map("company_id")
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  variableId String   @map("variable_id")
  variable   Variable @relation(fields: [variableId], references: [id], onDelete: Cascade)
  value      String

  @@unique([companyId, variableId])
  @@map("company_variable_values")
}

model Template {
  id        String   @id @default(cuid())
  name      String
  fileUrl   String   @map("file_url")
  createdAt DateTime @default(now()) @map("created_at")

  documents GeneratedDocument[]

  @@map("templates")
}

model GeneratedDocument {
  id          String   @id @default(cuid())
  fileName    String?  @map("file_name")
  folderId    String?  @map("folder_id")
  folder      CompanyFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  templateId  String   @map("template_id")
  template    Template @relation(fields: [templateId], references: [id])
  companyId   String   @map("company_id")
  company     Company  @relation(fields: [companyId], references: [id])
  docxUrl     String   @map("docx_url")
  pdfUrl      String?  @map("pdf_url")
  variables   Json?    @map("variables")
  generatedAt DateTime @default(now()) @map("generated_at")

  @@map("generated_documents")
}

model CompanyFolder {
  id             String          @id @default(cuid())
  companyId      String          @map("company_id")
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parentFolderId String?         @map("parent_folder_id")
  parentFolder   CompanyFolder?  @relation("CompanyFolderTree", fields: [parentFolderId], references: [id], onDelete: Cascade)
  children       CompanyFolder[] @relation("CompanyFolderTree")
  name           String
  path           String          @unique
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  documents      GeneratedDocument[]

  @@index([companyId, parentFolderId])
  @@map("company_folders")
}
