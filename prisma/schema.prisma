generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OwnerType {
  SINGLE
  MULTIPLE
}

model Company {
  id               String              @id @default(cuid())
  englishName      String              @map("english_name")
  nepaliName       String              @map("nepali_name")
  ownerType        OwnerType           @default(SINGLE) @map("owner_type")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  owners           CompanyOwner[]
  witnesses        CompanyWitness[]
  objectives       CompanyObjective[]
  variableValues   CompanyVariableValue[]
  documents        GeneratedDocument[]
  folders          CompanyFolder[]

  @@map("companies")
}

model CompanyOwner {
  id                  String   @id @default(cuid())
  companyId           String   @map("company_id")
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                String
  fatherName          String?  @map("father_name")
  address             String?
  citizenship         String?
  jariJilla           String?  @map("jari_jilla")
  citizenshipJariDate String?  @map("citizenship_jari_date")
  phoneNumber         String?  @map("phone_number")
  shares              String?
  order               Int      @default(0)

  @@map("company_owners")
}

model CompanyWitness {
  id                  String   @id @default(cuid())
  companyId           String   @map("company_id")
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                String
  address             String?
  citizenship         String?
  jariJilla           String?  @map("jari_jilla")
  citizenshipJariDate String?  @map("citizenship_jari_date")
  phoneNumber         String?  @map("phone_number")
  ownerIndex          Int?     @map("owner_index") // 1-based index of the owner this witness belongs to; null = general
  order               Int      @default(0)

  @@map("company_witnesses")
}

model ObjectiveCategory {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  order       Int         @default(0)
  createdAt   DateTime    @default(now()) @map("created_at")
  objectives  Objective[]

  @@map("objective_categories")
}

model Objective {
  id         String             @id @default(cuid())
  categoryId String?            @map("category_id")
  category   ObjectiveCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  text       String
  createdAt  DateTime           @default(now()) @map("created_at")

  @@map("objectives")
}

model CompanyObjective {
  id                String   @id @default(cuid())
  companyId         String   @map("company_id")
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceObjectiveId String?  @map("source_objective_id")
  text              String
  order             Int      @default(0)

  @@map("company_objectives")
}

model Variable {
  id    String @id @default(cuid())
  key   String @unique
  label String
  type  String @default("text") // text | date | number | list

  companyValues CompanyVariableValue[]

  @@map("variables")
}

model CompanyVariableValue {
  id         String   @id @default(cuid())
  companyId  String   @map("company_id")
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  variableId String   @map("variable_id")
  variable   Variable @relation(fields: [variableId], references: [id], onDelete: Cascade)
  value      String

  @@unique([companyId, variableId])
  @@map("company_variable_values")
}

model Template {
  id        String   @id @default(cuid())
  name      String
  fileUrl   String   @map("file_url")
  createdAt DateTime @default(now()) @map("created_at")

  documents GeneratedDocument[]

  @@map("templates")
}

model GeneratedDocument {
  id          String   @id @default(cuid())
  fileName    String?  @map("file_name")
  folderId    String?  @map("folder_id")
  folder      CompanyFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  templateId  String   @map("template_id")
  template    Template @relation(fields: [templateId], references: [id])
  companyId   String   @map("company_id")
  company     Company  @relation(fields: [companyId], references: [id])
  docxUrl     String   @map("docx_url")
  pdfUrl      String?  @map("pdf_url")
  variables   Json?    @map("variables")
  generatedAt DateTime @default(now()) @map("generated_at")

  @@map("generated_documents")
}

model CompanyFolder {
  id             String          @id @default(cuid())
  companyId      String          @map("company_id")
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parentFolderId String?         @map("parent_folder_id")
  parentFolder   CompanyFolder?  @relation("CompanyFolderTree", fields: [parentFolderId], references: [id], onDelete: Cascade)
  children       CompanyFolder[] @relation("CompanyFolderTree")
  name           String
  path           String          @unique
  isDefault      Boolean         @default(false) @map("is_default")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  documents      GeneratedDocument[]

  @@index([companyId, parentFolderId])
  @@map("company_folders")
}

// ─────────────────────────────────────────────────────────────────────────────
// CHAT SYSTEM — all models below are additive and do not touch existing models
// ─────────────────────────────────────────────────────────────────────────────

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum ChannelType {
  PUBLIC
  PRIVATE
  DM
  ANNOUNCEMENT
}

enum MentionType {
  USER     // @username
  CHANNEL  // @channel — all channel members
  HERE     // @here — online members only (handled client-side)
  EVERYONE // @everyone — workspace-wide, admin only
  GROUP    // @groupname
}

enum NotifPref {
  ALL
  MENTIONS
  NOTHING
}

// ─── USER (Auth.js + Chat) ────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String?  @map("display_name")
  avatarUrl    String?  @map("avatar_url")
  role         UserRole @default(USER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Auth.js required relations
  accounts Account[]
  sessions Session[]

  // Chat relations
  sentMessages       Message[]
  channelMemberships ChannelMember[]
  notifications      Notification[]
  mentions           MessageMention[]
  groupMemberships   UserGroupMember[]
  createdChannels    Channel[]         @relation("ChannelCreator")
  createdGroups      UserGroup[]       @relation("GroupCreator")

  @@map("users")
}

// ─── AUTH.JS ADAPTER MODELS (required by @auth/prisma-adapter) ───────────────

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── CHANNELS ─────────────────────────────────────────────────────────────────

model Channel {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  type        ChannelType @default(PUBLIC)
  createdById String      @map("created_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")

  createdBy User            @relation("ChannelCreator", fields: [createdById], references: [id])
  members   ChannelMember[]
  messages  Message[]

  @@map("channels")
}

model ChannelMember {
  id         String    @id @default(cuid())
  channelId  String    @map("channel_id")
  userId     String    @map("user_id")
  notifPref  NotifPref @default(ALL) @map("notif_pref")
  lastReadAt DateTime  @default(now()) @map("last_read_at")
  joinedAt   DateTime  @default(now()) @map("joined_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@map("channel_members")
}

// ─── MESSAGES ─────────────────────────────────────────────────────────────────

model Message {
  id            String    @id @default(cuid())
  channelId     String    @map("channel_id")
  senderId      String    @map("sender_id")
  contentRaw    String    @db.Text @map("content_raw")
  contentParsed Json      @map("content_parsed")
  parentId      String?   @map("parent_id")
  isEdited      Boolean   @default(false) @map("is_edited")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  channel       Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender        User             @relation(fields: [senderId], references: [id])
  parent        Message?         @relation("ThreadReplies", fields: [parentId], references: [id])
  replies       Message[]        @relation("ThreadReplies")
  mentions      MessageMention[]
  notifications Notification[]

  @@map("messages")
}

// ─── MENTIONS ─────────────────────────────────────────────────────────────────

model MessageMention {
  id              String      @id @default(cuid())
  messageId       String      @map("message_id")
  mentionedUserId String?     @map("mentioned_user_id")
  groupId         String?     @map("group_id")
  mentionType     MentionType @map("mention_type")

  message       Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mentionedUser User?      @relation(fields: [mentionedUserId], references: [id])
  group         UserGroup? @relation(fields: [groupId], references: [id])

  @@map("message_mentions")
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  messageId String   @map("message_id")
  channelId String?  @map("channel_id")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─── USER GROUPS ──────────────────────────────────────────────────────────────

model UserGroup {
  id          String   @id @default(cuid())
  name        String
  handle      String   @unique // e.g. "devs" for @devs
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  createdBy User              @relation("GroupCreator", fields: [createdById], references: [id])
  members   UserGroupMember[]
  mentions  MessageMention[]

  @@map("user_groups")
}

model UserGroupMember {
  id      String @id @default(cuid())
  groupId String @map("group_id")
  userId  String @map("user_id")

  group UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("user_group_members")
}

